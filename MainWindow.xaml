<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island" Width="520" Height="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False" AllowDrop="True"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="White">

    <Window.Resources>
        <LinearGradientBrush x:Key="ArtFallback" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3A3A3C" Offset="0" />
            <GradientStop Color="#1C1C1E" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Orange" Color="#FF9F0A" />
        <SolidColorBrush x:Key="Green" Color="#30D158" />

        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8EFFFFFF" />
        </Style>

        <Style x:Key="MediaButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="20" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2C2C2E" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2C2C2E" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0A84FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Margin" Value="0,3,0,8" />
        </Style>

        <Style x:Key="BarFill" TargetType="Border">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        </Style>

        <Style x:Key="Panel" TargetType="Grid">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="IslandHost" Width="180" Height="34"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
              RenderTransformOrigin="0.5,0"
              SizeChanged="IslandHost_SizeChanged"
              MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
              MouseLeftButtonUp="Island_Click" PreviewMouseWheel="Island_PreviewMouseWheel"
              DragEnter="Island_DragEnter" DragOver="Island_DragOver" Drop="Island_Drop"
              ContextMenuOpening="Island_ContextMenuOpening">

            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="HideScale" />
                    <TranslateTransform x:Name="HideShift" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="AutostartItem" Header="Запускать вместе с Windows" IsCheckable="True" Click="Autostart_Click" />
                    <MenuItem Header="Настройки…" Click="OpenSettings_Click" FontWeight="SemiBold" />
                    <MenuItem Header="Тестовое уведомление" Click="TestNotification_Click" />
                    <Separator />
                    <MenuItem Header="Выход" Click="Exit_Click" />
                </ContextMenu>
            </Grid.ContextMenu>

            <Border x:Name="IslandBg" Background="Black" CornerRadius="17">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black" />
                </Border.Effect>
            </Border>

            <Grid x:Name="ContentRoot">

                <!-- Пустой остров -->
                <Grid x:Name="PanelIdle" Width="180" Height="34" Style="{StaticResource Panel}" />

                <!-- Компактный плеер: обложка слева, эквалайзер справа -->
                <Grid x:Name="PanelMusicCompact" Width="300" Height="34" Style="{StaticResource Panel}">
                    <Border x:Name="CompactArt" Width="24" Height="24" CornerRadius="7" HorizontalAlignment="Left" Margin="6,0,0,0"
                            Background="{StaticResource ArtFallback}">
                        <TextBlock x:Name="CompactArtGlyph" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="CompactEq" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" />
                </Grid>

                <!-- Компактный таймер / секундомер -->
                <Grid x:Name="PanelTimerCompact" Width="300" Height="34" Style="{StaticResource Panel}">
                    <Grid Margin="14,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TimerCompactGlyph" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Orange}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TimerCompactLabel" FontSize="12" Foreground="{StaticResource Orange}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TimerCompactText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{StaticResource Orange}" Typography.NumeralAlignment="Tabular" />
                    </Grid>
                </Grid>

                <!-- Громкость / яркость -->
                <Grid x:Name="PanelOsd" Width="320" Height="34" Style="{StaticResource Panel}">
                    <Grid Margin="14,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OsdGlyph" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Height="5" CornerRadius="2.5" Background="#33FFFFFF" Margin="10,0" VerticalAlignment="Center">
                            <Border CornerRadius="2.5" Background="White" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="OsdScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock x:Name="OsdText" Grid.Column="2" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                    </Grid>
                </Grid>

                <!-- Зарядка -->
                <Grid x:Name="PanelCharging" Width="340" Height="34" Style="{StaticResource Panel}">
                    <Grid Margin="16,0,14,0">
                        <TextBlock Text="Заряжается" FontSize="13" Foreground="{StaticResource Green}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ChargeText" FontSize="13" Foreground="{StaticResource Green}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Border Width="27" Height="14" CornerRadius="4" BorderBrush="#8EFFFFFF" BorderThickness="1.2" Padding="1.5">
                                <Border CornerRadius="2" Background="{StaticResource Green}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ChargeScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <Border Width="2" Height="5" CornerRadius="1" Background="#8EFFFFFF" Margin="1,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Развёрнутый плеер -->
                <Grid x:Name="PanelMusic" Width="440" Height="180" Style="{StaticResource Panel}">
                    <Grid Margin="20,18,30,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MusicArt" CornerRadius="13" Background="{StaticResource ArtFallback}">
                                <TextBlock x:Name="MusicArtGlyph" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MusicSource" FontSize="11" Style="{StaticResource Dim}" />
                                <TextBlock x:Name="MusicTitle" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MusicArtist" FontSize="13" Foreground="#B0FFFFFF" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel x:Name="ExpandedEq" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" />
                        </Grid>

                        <Grid x:Name="ProgressRow" Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PositionText" FontSize="11" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                            <Grid x:Name="ProgressTrack" Grid.Column="1" Height="14" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="Progress_MouseDown">
                                <Border Height="5" CornerRadius="2.5" Background="#33FFFFFF" VerticalAlignment="Center" />
                                <Border Height="5" CornerRadius="2.5" Background="White" VerticalAlignment="Center" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="11" Style="{StaticResource Dim}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Style="{StaticResource MediaButton}" Content="&#xE892;" Click="Previous_Click" />
                            <Button x:Name="PlayPauseButton" Style="{StaticResource MediaButton}" FontSize="26" Margin="18,0"
                                    Content="&#xE768;" Click="PlayPause_Click" />
                            <Button Style="{StaticResource MediaButton}" Content="&#xE893;" Click="Next_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Главная: часы, погода, система -->
                <Grid x:Name="PanelWidgets" Width="440" Height="160" Style="{StaticResource Panel}">
                    <Grid Margin="24,18,30,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <local:ClockFace x:Name="HomeClock" />
                        </Viewbox>

                        <Border Grid.Column="1" Background="#1FFFFFFF" Margin="0,10" />

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="WeatherIcon" FontFamily="Segoe UI Emoji" FontSize="24" VerticalAlignment="Center" Text="🌡" />
                                <TextBlock x:Name="WeatherTemp" FontSize="28" Margin="8,0,0,0" Text="--°" />
                            </StackPanel>
                            <TextBlock x:Name="WeatherDesc" FontSize="12" TextTrimming="CharacterEllipsis" Text="Загрузка…" />
                            <TextBlock x:Name="WeatherCity" FontSize="11" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border Grid.Column="3" Background="#1FFFFFFF" Margin="0,10" />

                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Grid>
                                <TextBlock x:Name="BatteryLabel" FontSize="11" Style="{StaticResource Dim}" Text="Батарея" />
                                <TextBlock x:Name="BatteryText" FontSize="11" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Style="{StaticResource BarTrack}">
                                <Border x:Name="BatteryFill" Style="{StaticResource BarFill}">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="BatteryScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <Grid>
                                <TextBlock FontSize="11" Style="{StaticResource Dim}" Text="Процессор" />
                                <TextBlock x:Name="CpuText" FontSize="11" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Style="{StaticResource BarTrack}">
                                <Border Style="{StaticResource BarFill}">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="CpuScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <Grid>
                                <TextBlock FontSize="11" Style="{StaticResource Dim}" Text="Память" />
                                <TextBlock x:Name="RamText" FontSize="11" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Style="{StaticResource BarTrack}" Margin="0,3,0,0">
                                <Border Style="{StaticResource BarFill}">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="RamScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Календарь -->
                <Grid x:Name="PanelCalendar" Width="440" Height="190" Style="{StaticResource Panel}">
                    <DockPanel Margin="22,16,30,12">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FF453A" VerticalAlignment="Center" />
                                <TextBlock Text="Календарь" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="CalendarDate" FontSize="12" Style="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <StackPanel x:Name="CalendarList" />
                            <TextBlock x:Name="CalendarHint" FontSize="12" Style="{StaticResource Dim}" TextWrapping="Wrap"
                                       Cursor="Hand" MouseLeftButtonUp="CalendarHint_Click"
                                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- Таймер и секундомер -->
                <Grid x:Name="PanelTimer" Width="440" Height="168" Style="{StaticResource Panel}">
                    <Grid Margin="22,14,30,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.85*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Секундомер" FontSize="12" Style="{StaticResource Dim}" />
                            <TextBlock x:Name="StopwatchText" FontSize="30" FontWeight="Light" Text="0:00.0"
                                       Typography.NumeralAlignment="Tabular" Margin="0,2,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="StopwatchToggle" Style="{StaticResource RoundButton}" Background="{StaticResource Orange}"
                                        Content="&#xE768;" Click="StopwatchToggle_Click" />
                                <Button Style="{StaticResource RoundButton}" Content="&#xE72C;" Margin="8,0,0,0" Click="StopwatchReset_Click" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#1FFFFFFF" Margin="0,6" />

                        <StackPanel Grid.Column="2" Margin="18,0,0,0">
                            <TextBlock Text="Таймер" FontSize="12" Style="{StaticResource Dim}" />
                            <TextBlock x:Name="CountdownText" FontSize="30" FontWeight="Light" Text="5:00"
                                       Typography.NumeralAlignment="Tabular" Margin="0,2,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RoundButton}" Content="&#xE738;" Click="CountdownMinus_Click" />
                                <Button x:Name="CountdownToggle" Style="{StaticResource RoundButton}" Background="{StaticResource Orange}"
                                        Margin="8,0" Content="&#xE768;" Click="CountdownToggle_Click" />
                                <Button Style="{StaticResource RoundButton}" Content="&#xE710;" Click="CountdownPlus_Click" />
                                <Button Style="{StaticResource RoundButton}" Content="&#xE72C;" Margin="8,0,0,0" Click="CountdownReset_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource ChipButton}" Content="1м" Tag="1" Click="Preset_Click" />
                                <Button Style="{StaticResource ChipButton}" Content="5м" Tag="5" Click="Preset_Click" />
                                <Button Style="{StaticResource ChipButton}" Content="15м" Tag="15" Click="Preset_Click" />
                                <Button Style="{StaticResource ChipButton}" Content="30м" Tag="30" Click="Preset_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Полка для файлов -->
                <Grid x:Name="PanelShelf" Width="440" Height="150" Style="{StaticResource Panel}">
                    <DockPanel Margin="22,14,30,14">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#64D2FF" VerticalAlignment="Center" />
                                <TextBlock Text="Полка" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ShelfCount" FontSize="12" Style="{StaticResource Dim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="ShelfClear" Style="{StaticResource LinkButton}" Content="Очистить" HorizontalAlignment="Right" Click="ShelfClear_Click" />
                        </Grid>
                        <Grid>
                            <Rectangle x:Name="ShelfDrop" RadiusX="12" RadiusY="12" Stroke="#40FFFFFF" StrokeThickness="1.5" StrokeDashArray="4 3" />
                            <TextBlock x:Name="ShelfHint" Text="Перетащите файлы сюда" FontSize="12" Style="{StaticResource Dim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ScrollViewer x:Name="ShelfScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ShelfItems" Orientation="Horizontal" Margin="4,4,4,0" />
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Grid>

                <!-- Уведомление / смена трека / будильник -->
                <Grid x:Name="PanelNotify" Width="400" Height="76" Style="{StaticResource Panel}">
                    <Grid Margin="14,12,8,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="NotifyIcon" Width="48" Height="48" CornerRadius="13" Background="#333">
                            <TextBlock x:Name="NotifyInitial" FontSize="21" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,4,0">
                            <Grid>
                                <TextBlock x:Name="NotifyApp" FontSize="11" Style="{StaticResource Dim}" Margin="0,0,50,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="NotifyTime" FontSize="11" Style="{StaticResource Dim}" HorizontalAlignment="Right" Text="сейчас" />
                            </Grid>
                            <TextBlock x:Name="NotifyTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NotifyBody" FontSize="13" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource MediaButton}" Width="28" Height="28" FontSize="10"
                                Foreground="#8EFFFFFF" Content="&#xE711;" VerticalAlignment="Center" Click="NotifyClose_Click" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- Индикатор страниц: листается колесом мыши -->
            <StackPanel x:Name="PageDots" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
